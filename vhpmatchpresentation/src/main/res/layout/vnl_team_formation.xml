<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#000000"
        android:padding="12dp"
        android:gravity="center_horizontal">

        <!-- Top Team Accent Line -->
        <View
            android:id="@+id/teamColorAccentBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#0284C7"
            android:layout_marginBottom="8dp" />

        <!-- Header: Logo & Team Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/imgTeamLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_silhouette"
                android:contentDescription="Team Logo"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtTeamName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="TEAM LINEUP"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2" />
        </LinearLayout>

        <!-- Players List Container -->
        <LinearLayout
            android:id="@+id/playersListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
