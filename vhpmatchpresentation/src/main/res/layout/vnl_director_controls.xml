<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#CC0F172A"
    android:padding="6dp"
    android:gravity="center_vertical">

    <ImageButton
        android:id="@+id/btnMinimize"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_minimize"
        android:contentDescription="Minimize Overlay" />

    <ImageButton
        android:id="@+id/btnPrevPlayer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_prev"
        android:contentDescription="Previous Player" />

    <ImageButton
        android:id="@+id/btnPlayPause"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_pause"
        android:contentDescription="Play/Pause" />

    <ImageButton
        android:id="@+id/btnNextPlayer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_next"
        android:contentDescription="Next Player" />

    <Button
        android:id="@+id/btnSkipTeam"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:text="SKIP"
        android:textColor="#00E5FF"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btnShowScoreboard"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:text="SCORE"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btnStopSave"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="@android:color/transparent"
        android:text="STOP &amp; SAVE"
        android:textColor="#FF5252"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
