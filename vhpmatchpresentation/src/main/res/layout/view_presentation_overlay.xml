<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayRootLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Expanded Panel -->
    <LinearLayout
        android:id="@+id/expandedPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Simplified Minimalist Director Bar -->
        <LinearLayout
            android:id="@+id/dragHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#CC0F172A"
            android:padding="6dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_minimize"
                android:contentDescription="Minimize Overlay" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_pause"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/btnNextPlayer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_next"
                android:contentDescription="Next" />

            <Button
                android:id="@+id/btnShowScoreboard"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:text="SCORE"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnStopSave"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent"
                android:text="STOP"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Presentation Content Container (Recorded to Video) -->
        <LinearLayout
            android:id="@+id/presentationContentContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#000000">

            <!-- Presentation Cards Frame -->
            <FrameLayout
                android:id="@+id/presentationFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Broadcast Scoreboard Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/liveScoreboardLayout"
                android:layout_width="320dp"
                android:layout_height="36dp"
                android:visibility="gone"
                app:cardCornerRadius="6dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#000000">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- TEAM A LOGO -->
                    <ImageView
                        android:id="@+id/logo_team_a"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="2dp"
                        android:src="@drawable/logo2" />

                    <!-- TEAM A NAME & SETS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/serve_team_a"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏐"
                            android:textSize="10sp"
                            android:visibility="invisible"
                            android:layout_marginEnd="2dp" />

                        <TextView
                            android:id="@+id/name_team_a"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="#00FBFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="VPM" />

                        <TextView
                            android:id="@+id/sets_team_a"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S:0"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SCORE A -->
                    <TextView
                        android:id="@+id/score_team_a"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:background="#1E293B"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="0" />

                    <!-- VHP LOGO BADGE (Using logosito.png) -->
                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:background="#150B30"
                        android:padding="2dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logosito"
                            android:contentDescription="VHP Logo" />
                    </FrameLayout>

                    <!-- SCORE B -->
                    <TextView
                        android:id="@+id/score_team_b"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:background="#1E293B"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="0" />

                    <!-- TEAM B NAME & SETS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/sets_team_b"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S:0"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/name_team_b"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="#FF0055"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="end"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="VHU" />

                        <TextView
                            android:id="@+id/serve_team_b"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏐"
                            android:textSize="10sp"
                            android:visibility="invisible"
                            android:layout_marginStart="2dp" />
                    </LinearLayout>

                    <!-- TEAM B LOGO -->
                    <ImageView
                        android:id="@+id/logo_team_b"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="2dp"
                        android:src="@drawable/logo2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>

    <!-- Minimized Floating Bubble -->
    <FrameLayout
        android:id="@+id/minimizedBubble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#CC0F172A"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_play"
            android:contentDescription="Expand Overlay" />
    </FrameLayout>

</FrameLayout>
